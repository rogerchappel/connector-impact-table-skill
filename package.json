{
  "name": "connector-impact-table-skill",
  "version": "0.1.0",
  "description": "Prepare local impact tables for planned connector actions",
  "type": "module",
  "bin": {
    "connector-impact-table-skill": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SKILL.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs",
    "examples",
    "src",
    "scripts",
    "tests"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.js",
    "smoke": "npm run build && node dist/src/cli.js --help && node dist/src/cli.js examples/sample.txt --format markdown",
    "package:smoke": "node scripts/package-smoke.js",
    "validate": "bash scripts/validate.sh",
    "release:check": "npm run validate && npm run package:smoke"
  },
  "keywords": [
    "agent-skill",
    "cli",
    "local-first",
    "fixtures"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/connector-impact-table-skill.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/connector-impact-table-skill/issues"
  },
  "homepage": "https://github.com/rogerchappel/connector-impact-table-skill#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.5.4"
  }
}
